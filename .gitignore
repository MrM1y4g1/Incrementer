# Godot import cache and editor state
.godot/
/android/

# Exported builds
/builds/*
!/builds/.gdignore

# Local tools: the Godot binary and its self-contained editor data
/.tools/

# Local-only tool config
/.impeccable/*.local.json
/.impeccable/hook.cache.json

# OS and editor clutter
.DS_Store
Thumbs.db
*.tmp

# Local scratch files, such as reference tracks that must never be published
tmp/
